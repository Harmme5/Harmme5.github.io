{{- $.Scratch.Add "index" slice -}}
{{- range where .Site.RegularPages "Type" "in" (slice "post") -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "date" (.Date.Format "2006-01-02T15:04:05Z07:00") "permalink" .Permalink "wordcount" .WordCount) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
